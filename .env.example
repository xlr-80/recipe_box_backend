# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=recipebox

# Access token (stateless JWT)
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token (opaque, stored hashed in Mongo, revocable)
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=*

# --- Email verification ---
# If EMAIL_BACKEND=console, verification emails are just printed to the
# server log — fine for dev. Switch to "smtp" and fill in the SMTP_*
# fields to actually send mail in production.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@recipebox.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_VERIFICATION_EXPIRE_HOURS=24
# If true, login is blocked until the email is verified. Off by default
# for easier local development.
REQUIRE_EMAIL_VERIFICATION=false
# Base URL the verification link points at (your app's web landing page
# or a deep link handler) — the token is appended as ?token=...
EMAIL_VERIFICATION_BASE_URL=https://recipebox.app/verify-email

# --- Google OAuth ---
# The OAuth client ID from Google Cloud Console. The backend checks
# that any ID token presented was issued for this exact client.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Firebase Cloud Messaging ---
# Path to a Firebase service-account JSON file (Project Settings ->
# Service Accounts -> Generate new private key). Leave blank to disable
# push sending — device registration still works, sends just no-op with
# a log line instead of erroring.
FCM_SERVICE_ACCOUNT_PATH=
